# Regra padrão: arquivos de texto sempre com LF
* text=auto eol=lf

# Código e documentação
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.env.example text eol=lf

# Frontend
*.js text eol=lf
*.ts text eol=lf
*.jsx text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf

# Docker
Dockerfile text eol=lf
*.dockerfile text eol=lf

# Binários: não mexer
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.7z binary
*.exe binary
*.dll binary

*.bat text eol=crlf
*.cmd text eol=crlf
